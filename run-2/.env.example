# Copiez ce fichier en .env (il n'est jamais commité) puis remplissez les valeurs.

# URL publique de l'app (liens affichés, retours Stripe, cookie Secure si https)
# BASE_URL=https://waitlist.example.com

# Derrière un reverse proxy (Nginx, Render, Fly…) : lire l’IP réelle du visiteur (parrainage, limites anti-abus)
# TRUST_PROXY=1

# Stripe — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Secret du endpoint webhook (Dashboard > Développeurs > Webhooks, ou affiché par `stripe listen`)
STRIPE_WEBHOOK_SECRET=whsec_...
# Facultatif : prix à utiliser. Sinon un prix « Waitlist Pro » à 9 €/mois est créé automatiquement.
# STRIPE_PRICE_ID=price_...
