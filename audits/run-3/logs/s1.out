##### 9. open redirect
next=//evil.example  logged-in -> Location: /app$
         logged-out data-next -> data-next="/app"$
next=/\evil.example  logged-in -> Location: /app$
         logged-out data-next -> data-next="/app"$
next=https://evil.example  logged-in -> Location: /app$
         logged-out data-next -> data-next="/app"$
next=/%09/evil.example  logged-in -> Location: /^I/evil.example$
         logged-out data-next -> data-next="/^I/evil.example"$
next=/%0a/evil.example  logged-in -> 
         logged-out data-next -> 
next=/app/lists/x  logged-in -> Location: /app/lists/x$
         logged-out data-next -> data-next="/app/lists/x"$
